{
  "name": "langbara-express",
  "version": "1.0.0",
  "description": "LangBara Express API",
  "main": "src/app.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "start-nltk": "concurrently \"node dist/app.js\" \"uvicorn main:app --port 7000\"",
    "test": "jest",
    "dev": "npx nodemon",
    "dev-nltk": "concurrently \"npx nodemon\" \"uvicorn main:app --port 7000 --reload\"",
    "setup-nltk": "pip install -r nltkapi/requirements.txt & python nltkapi/setup.py",
    "setup-nltk3": "pip3 install -r nltkapi/requirements.txt & python3 nltkapi/setup.py"
  },
  "author": "LangBara Team",
  "license": "ISC",
  "dependencies": {
    "@types/speakeasy": "^2.0.7",
    "axios": "^0.27.2",
    "bcrypt": "^5.0.1",
    "concurrently": "^7.5.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.0.2",
    "express": "^4.18.1",
    "log4js": "^6.6.1",
    "pg": "^8.8.0",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.0.2",
    "@types/node": "^18.7.15",
    "@types/pg": "^8.6.5",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^8.3.4",
    "jest": "^29.0.3",
    "nodemon": "^2.0.19",
    "supertest": "^6.2.4",
    "ts-jest": "^29.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.2"
  }
}
